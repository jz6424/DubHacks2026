{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": ".venv/bin/uvicorn",
      "runtimeArgs": ["--app-dir", "backend", "app.main:app", "--reload", "--reload-dir", "backend/app", "--port", "8000"],
